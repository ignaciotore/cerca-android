<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:id="@+id/loadingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingTop="80dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H.E.L.P" android:textColor="#173B46" android:textSize="38sp" android:textStyle="bold" android:letterSpacing="0.08"/>
            <ProgressBar android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="26dp"/>
            <TextView android:id="@+id/loadingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preparando tu red de ayuda…" android:textColor="#667177" android:textSize="16sp" android:gravity="center" android:layout_marginTop="18dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/authPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="H.E.L.P" android:textColor="#173B46" android:textSize="38sp" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.08"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu red de ayuda, siempre cerca" android:textColor="#263238" android:textSize="27sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iniciá sesión para acceder a tu cuenta y mantener tus activaciones vinculadas a vos." android:textColor="#667177" android:textSize="16sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" android:layout_marginBottom="22dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Iniciar sesión" android:textColor="#173B46" android:textSize="21sp" android:textStyle="bold"/>
                <EditText android:id="@+id/loginEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" android:importantForAutofill="yes" android:autofillHints="emailAddress" android:textSize="16sp" android:background="@drawable/input_bg" android:layout_marginTop="14dp"/>
                <EditText android:id="@+id/loginPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Contraseña" android:inputType="textPassword" android:importantForAutofill="yes" android:autofillHints="password" android:textSize="16sp" android:background="@drawable/input_bg" android:layout_marginTop="10dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="ENTRAR" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="16dp" app:backgroundTint="#173B46" app:cornerRadius="17dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/forgotPasswordButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="OLVIDÉ MI CONTRASEÑA" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="15dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/createAccountNavButton" android:layout_width="match_parent" android:layout_height="54dp" android:text="CREAR CUENTA" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="16dp" app:backgroundTint="#E6F0ED" app:cornerRadius="17dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/authPrivacyButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="PRIVACIDAD" android:textColor="#65747A" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#FAF7F2" app:cornerRadius="15dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/signupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crear cuenta H.E.L.P" android:textColor="#173B46" android:textSize="30sp" android:textStyle="bold" android:gravity="center"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu cuenta permite recuperar el acceso, mantener tu período de prueba y registrar las activaciones de ayuda." android:textColor="#667177" android:textSize="16sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg">
                <EditText android:id="@+id/signupName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre y apellido" android:inputType="textPersonName" android:textSize="16sp" android:background="@drawable/input_bg"/>
                <EditText android:id="@+id/signupEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" android:textSize="16sp" android:background="@drawable/input_bg" android:layout_marginTop="10dp"/>
                <EditText android:id="@+id/signupPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Contraseña (mínimo 8 caracteres)" android:inputType="textPassword" android:textSize="16sp" android:background="@drawable/input_bg" android:layout_marginTop="10dp"/>
                <EditText android:id="@+id/signupPassword2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Repetir contraseña" android:inputType="textPassword" android:textSize="16sp" android:background="@drawable/input_bg" android:layout_marginTop="10dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/signupButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="CREAR MI CUENTA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="16dp" app:backgroundTint="#173B46" app:cornerRadius="17dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/backLoginButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="YA TENGO CUENTA" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#EEE8E0" app:cornerRadius="16dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="H.E.L.P" android:textColor="#173B46" android:textSize="36sp" android:textStyle="bold" android:gravity="center" android:letterSpacing="0.08"/>
            <TextView android:id="@+id/setupTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configurá tu red de ayuda" android:textColor="#263238" android:textSize="27sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/setupSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elegí los contactos que recibirán el aviso y la llamada." android:textColor="#667177" android:textSize="16sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp" android:layout_marginBottom="22dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu nombre" android:textColor="#173B46" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Se incluye en el aviso para identificar quién necesita ayuda." android:textColor="#7B858A" android:textSize="14sp" android:layout_marginTop="3dp" android:layout_marginBottom="12dp"/>
                <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre y apellido" android:inputType="textPersonName" android:textSize="16sp" android:background="@drawable/input_bg"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Llamada de ayuda" android:textColor="#173B46" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elegí a quién H.E.L.P llamará después de enviar el aviso." android:textColor="#7B858A" android:textSize="14sp" android:layout_marginTop="3dp" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/callContactDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Todavía no elegiste un contacto" android:textColor="#2E3C42" android:textSize="16sp" android:textStyle="bold" android:padding="14dp" android:background="@drawable/soft_bg"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/pickCallContactButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="BUSCAR EN MIS CONTACTOS" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="12dp" app:backgroundTint="#173B46" app:cornerRadius="16dp"/>
                <EditText android:id="@+id/callPhoneManual" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="O escribir número manualmente" android:inputType="phone" android:textSize="15sp" android:background="@drawable/input_bg" android:layout_marginTop="10dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contactos que recibirán el SMS" android:textColor="#173B46" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Elegí de 1 a 4 contactos. El mensaje incluirá un link puntual de Google Maps." android:textColor="#7B858A" android:textSize="14sp" android:layout_marginTop="3dp" android:layout_marginBottom="14dp"/>
                <TextView android:id="@+id/sms1Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto 1 · Sin elegir" android:textColor="#2E3C42" android:textSize="15sp" android:padding="13dp" android:background="@drawable/soft_bg"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/pickSms1Button" android:layout_width="match_parent" android:layout_height="46dp" android:text="ELEGIR CONTACTO 1" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="14dp"/>
                <TextView android:id="@+id/sms2Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto 2 · Opcional" android:textColor="#2E3C42" android:textSize="15sp" android:padding="13dp" android:background="@drawable/soft_bg" android:layout_marginTop="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/pickSms2Button" android:layout_width="match_parent" android:layout_height="46dp" android:text="ELEGIR CONTACTO 2" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="14dp"/>
                <TextView android:id="@+id/sms3Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto 3 · Opcional" android:textColor="#2E3C42" android:textSize="15sp" android:padding="13dp" android:background="@drawable/soft_bg" android:layout_marginTop="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/pickSms3Button" android:layout_width="match_parent" android:layout_height="46dp" android:text="ELEGIR CONTACTO 3" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="14dp"/>
                <TextView android:id="@+id/sms4Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto 4 · Opcional" android:textColor="#2E3C42" android:textSize="15sp" android:padding="13dp" android:background="@drawable/soft_bg" android:layout_marginTop="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/pickSms4Button" android:layout_width="match_parent" android:layout_height="46dp" android:text="ELEGIR CONTACTO 4" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="14dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/saveSetupButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="GUARDAR Y CONTINUAR" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="18dp" app:backgroundTint="#173B46" app:cornerRadius="18dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/cancelEditButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="CANCELAR" android:textColor="#173B46" android:textStyle="bold" android:visibility="gone" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="18dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/demoDataButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="CARGAR DATOS DE DEMO" android:textColor="#173B46" android:textStyle="bold" android:visibility="gone" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="16dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H.E.L.P" android:textColor="#173B46" android:textSize="34sp" android:textStyle="bold" android:letterSpacing="0.08"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ayuda cuando la necesitás" android:textColor="#6B767C" android:textSize="15sp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/profileButton" android:layout_width="wrap_content" android:layout_height="46dp" android:text="PERFIL" android:textColor="#173B46" android:textStyle="bold" app:backgroundTint="#EEE8E0" app:cornerRadius="16dp"/>
            </LinearLayout>
            <TextView android:id="@+id/trialBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prueba gratuita" android:textColor="#31664A" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/badge_bg" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginTop="22dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu red está configurada" android:textColor="#173B46" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:id="@+id/homeCallSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Llamada: —" android:textColor="#526067" android:textSize="15sp" android:layout_marginTop="9dp"/>
                <TextView android:id="@+id/homeSmsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Avisos por SMS: —" android:textColor="#526067" android:textSize="15sp" android:layout_marginTop="5dp"/>
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mantené apretado 3 segundos para pedir ayuda." android:textColor="#34444B" android:textSize="19sp" android:textStyle="bold" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="30dp" android:layout_marginBottom="18dp"/>
            <Button android:id="@+id/helpButton" android:layout_width="286dp" android:layout_height="286dp" android:background="@drawable/danger_circle" android:backgroundTint="@null" android:text="PEDIR&#10;AYUDA" android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" android:gravity="center" android:elevation="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Al activarlo, H.E.L.P envía el SMS con tu ubicación puntual y luego inicia la llamada configurada." android:textColor="#69767B" android:textSize="14sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="20dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/profilePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi cuenta" android:textColor="#173B46" android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:id="@+id/profileData" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#34444B" android:textSize="16sp" android:lineSpacingExtra="4dp" android:background="@drawable/card_bg" android:layout_marginTop="16dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/editProfileButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="EDITAR NOMBRE Y CONTACTOS" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="14dp" app:backgroundTint="#173B46" app:cornerRadius="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suscripción" android:textColor="#173B46" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:id="@+id/subscriptionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#5D6B71" android:textSize="15sp" android:layout_marginTop="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/subscribeButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="SUSCRIBIRME" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="12dp" app:backgroundTint="#D95F52" app:cornerRadius="15dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/manageSubscriptionButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="ADMINISTRAR EN GOOGLE PLAY" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="15dp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/privacyPolicyButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="POLÍTICA DE PRIVACIDAD" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="12dp" app:backgroundTint="#EEE8E0" app:cornerRadius="15dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/logoutButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="CERRAR SESIÓN" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#EEE8E0" app:cornerRadius="15dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/deleteAccountButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="ELIMINAR MI CUENTA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#D95F52" app:cornerRadius="15dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/profileBackButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="VOLVER" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#E6F0ED" app:cornerRadius="15dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/expiredPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:gravity="center_horizontal" android:paddingTop="40dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu prueba terminó" android:textColor="#173B46" android:textSize="29sp" android:textStyle="bold" android:gravity="center"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tus contactos siguen guardados. Suscribite para volver a usar PEDIR AYUDA." android:textColor="#65747A" android:textSize="16sp" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" android:layout_marginBottom="20dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/expiredSubscribeButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="SUSCRIBIRME" android:textColor="#FFFFFF" android:textStyle="bold" app:backgroundTint="#D95F52" app:cornerRadius="17dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/expiredProfileButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="VER MI CUENTA" android:textColor="#173B46" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#EEE8E0" app:cornerRadius="16dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/expiredPrivacyButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="PRIVACIDAD" android:textColor="#65747A" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#FAF7F2" app:cornerRadius="15dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
