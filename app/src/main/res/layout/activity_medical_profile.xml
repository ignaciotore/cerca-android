<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7FAF9">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CERCA ID" android:textColor="#0B5960" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.08"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ficha médica de emergencia" android:textColor="#203337" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Completá la información que te gustaría que alguien pueda ver para ayudarte en una emergencia." android:textColor="#657579" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="16dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nombre y apellido" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalFullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. Juan Pérez" android:inputType="textPersonName" android:background="@drawable/input_bg"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha de nacimiento" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalBirthDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tocá para elegir" android:inputType="none" android:focusable="false" android:clickable="true" android:background="@drawable/input_bg"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grupo sanguíneo" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalBloodType" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. A+" android:inputType="textCapCharacters" android:background="@drawable/input_bg"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alergias" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalAllergies" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. Penicilina, maní" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" android:background="@drawable/input_bg"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Condiciones médicas relevantes" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalConditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. Diabetes, hipertensión" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" android:background="@drawable/input_bg"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Obra social / prepaga" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalHealthProvider" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ej. OSDE" android:inputType="text" android:background="@drawable/input_bg"/>

      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Número de afiliado" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="5dp"/>
      <EditText android:id="@+id/medicalMemberNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número de socio / afiliado" android:inputType="text" android:background="@drawable/input_bg"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto médico de emergencia" android:textColor="#0B5960" android:textSize="19sp" android:textStyle="bold"/>
      <TextView android:id="@+id/medicalEmergencyContactDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Todavía no elegiste un contacto" android:textColor="#34444B" android:textSize="15sp" android:padding="13dp" android:background="@drawable/soft_bg" android:layout_marginTop="10dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/medicalPickContactButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="BUSCAR EN MIS CONTACTOS" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#0B5960" app:cornerRadius="15dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Medicación" android:textColor="#0B5960" android:textSize="19sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Los medicamentos cargados también forman parte de la ficha de emergencia compartida por CERCA ID." android:textColor="#657579" android:textSize="14sp" android:layout_marginTop="5dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/medicalMedicationsButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="MIS MEDICAMENTOS Y RECORDATORIOS" android:textColor="#0B5960" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#DDF2F0" app:cornerRadius="15dp"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Otra información importante" android:textColor="#0B5960" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="16dp" android:layout_marginBottom="5dp"/>
    <EditText android:id="@+id/medicalNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Cualquier dato útil en una emergencia" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" android:background="@drawable/input_bg"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acceso de emergencia" android:textColor="#0B5960" android:textSize="19sp" android:textStyle="bold"/>
      <CheckBox android:id="@+id/medicalShareEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Activar CERCA ID para compartir esta ficha por NFC" android:textColor="#34444B" android:textSize="15sp" android:checked="true" android:layout_marginTop="8dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CERCA intenta configurarse automáticamente. Android puede pedirte una confirmación la primera vez. La ficha usa un identificador aleatorio y no muestra tu email ni tu cuenta." android:textColor="#7B858A" android:textSize="13sp" android:lineSpacingExtra="2dp" android:layout_marginTop="6dp"/>
      <TextView android:id="@+id/medicalNfcStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisando NFC…" android:textColor="#0B5960" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
    </LinearLayout>

    <TextView android:id="@+id/medicalStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#657579" android:textSize="14sp" android:gravity="center" android:layout_marginTop="14dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/medicalSaveButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="GUARDAR FICHA MÉDICA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="12dp" app:backgroundTint="#0B5960" app:cornerRadius="17dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/medicalBackButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="VOLVER" android:textColor="#0B5960" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#F0F6F5" app:cornerRadius="16dp"/>
  </LinearLayout>
</ScrollView>