<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7FAF9">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CERCA ID" android:textColor="#0B5960" android:textSize="30sp" android:textStyle="bold" android:letterSpacing="0.08"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ficha médica de emergencia" android:textColor="#203337" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Completá la información que te gustaría que alguien pueda ver para ayudarte en una emergencia." android:textColor="#657579" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginTop="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="16dp">
      <EditText android:id="@+id/medicalFullName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nombre y apellido" android:inputType="textPersonName" android:background="@drawable/input_bg"/>
      <EditText android:id="@+id/medicalBirthDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Fecha de nacimiento · tocá para elegir" android:inputType="none" android:focusable="false" android:clickable="true" android:background="@drawable/input_bg" android:layout_marginTop="9dp"/>
      <EditText android:id="@+id/medicalBloodType" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Grupo sanguíneo · ej. A+" android:inputType="textCapCharacters" android:background="@drawable/input_bg" android:layout_marginTop="9dp"/>
      <EditText android:id="@+id/medicalAllergies" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Alergias" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" android:background="@drawable/input_bg" android:layout_marginTop="9dp"/>
      <EditText android:id="@+id/medicalConditions" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Condiciones médicas relevantes" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" android:background="@drawable/input_bg" android:layout_marginTop="9dp"/>
      <EditText android:id="@+id/medicalHealthProvider" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Obra social / prepaga" android:inputType="text" android:background="@drawable/input_bg" android:layout_marginTop="9dp"/>
      <EditText android:id="@+id/medicalMemberNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Número de afiliado" android:inputType="text" android:background="@drawable/input_bg" android:layout_marginTop="9dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contacto médico de emergencia" android:textColor="#0B5960" android:textSize="19sp" android:textStyle="bold"/>
      <TextView android:id="@+id/medicalEmergencyContactDisplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Todavía no elegiste un contacto" android:textColor="#34444B" android:textSize="15sp" android:padding="13dp" android:background="@drawable/soft_bg" android:layout_marginTop="10dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/medicalPickContactButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="BUSCAR EN MIS CONTACTOS" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#0B5960" app:cornerRadius="15dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Medicación" android:textColor="#0B5960" android:textSize="19sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargá cada remedio, dosis, días y horarios. Podés activar un recordatorio para cada uno." android:textColor="#657579" android:textSize="14sp" android:layout_marginTop="5dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/medicalMedicationsButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="MIS MEDICAMENTOS Y RECORDATORIOS" android:textColor="#0B5960" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#DDF2F0" app:cornerRadius="15dp"/>
    </LinearLayout>

    <EditText android:id="@+id/medicalNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Otra información importante" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" android:background="@drawable/input_bg" android:layout_marginTop="14dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:layout_marginTop="14dp">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acceso de emergencia" android:textColor="#0B5960" android:textSize="19sp" android:textStyle="bold"/>
      <CheckBox android:id="@+id/medicalShareEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permitir que CERCA ID muestre esta ficha mediante el enlace NFC" android:textColor="#34444B" android:textSize="15sp" android:checked="true" android:layout_marginTop="8dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="La ficha usa un identificador aleatorio. No se muestra tu email ni tu cuenta." android:textColor="#7B858A" android:textSize="13sp" android:lineSpacingExtra="2dp" android:layout_marginTop="6dp"/>
      <TextView android:id="@+id/medicalNfcStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Revisando NFC…" android:textColor="#0B5960" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="12dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Para que otra persona pueda leer tu ficha con tu teléfono bloqueado, Android debe dejar a CERCA como servicio para el canal NFC estándar." android:textColor="#657579" android:textSize="13sp" android:lineSpacingExtra="2dp" android:layout_marginTop="10dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/nfcDefaultButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="CONFIGURAR CERCA COMO NFC PREDETERMINADA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#0B5960" app:cornerRadius="15dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/nfcPriorityButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="PROBAR NFC CON IPHONE" android:textColor="#0B5960" android:textStyle="bold" android:layout_marginTop="10dp" app:backgroundTint="#DDF2F0" app:cornerRadius="15dp"/>
    </LinearLayout>

    <TextView android:id="@+id/medicalStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#657579" android:textSize="14sp" android:gravity="center" android:layout_marginTop="14dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/medicalSaveButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="GUARDAR FICHA MÉDICA" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="12dp" app:backgroundTint="#0B5960" app:cornerRadius="17dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/medicalViewPublicButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="VER COMO LA VERÍA OTRA PERSONA" android:textColor="#0B5960" android:textStyle="bold" android:visibility="gone" android:layout_marginTop="8dp" app:backgroundTint="#E8F2F0" app:cornerRadius="16dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/medicalBackButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="VOLVER" android:textColor="#0B5960" android:textStyle="bold" android:layout_marginTop="8dp" app:backgroundTint="#F0F6F5" app:cornerRadius="16dp"/>
  </LinearLayout>
</ScrollView>